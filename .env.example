# ============================================================
# Template for environment config.
# Copy this file to .env and fill in real values.
# NEVER commit .env (it is gitignored). This file contains NO real secrets.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://kortex:CHANGEME@localhost:5432/kortex
POSTGRES_PASSWORD=CHANGEME

# --- Redis ---
REDIS_URL=redis://:CHANGEME@localhost:6379/0
REDIS_PASSWORD=CHANGEME

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kortex_chunks

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGEME

# --- LLM (Primary: Anthropic Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Embeddings (OpenAI) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Source Connectors (empty = that connector disabled) ---
# GitHub personal access token (repo read scope) — for GITHUB source ingestion
GITHUB_TOKEN=
# Slack bot token (xoxb-...) with channels:history/read scopes — for SLACK source ingestion
SLACK_BOT_TOKEN=
# Gmail OAuth: path to client-secrets JSON and stored token JSON — for GMAIL source ingestion
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=
# Notion integration token — for NOTION source ingestion
NOTION_TOKEN=

# --- App ---
APP_ENV=development
SECRET_KEY=CHANGEME
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- API Auth ---
# Secret required in the X-API-Key header on all /api/v1 routes.
# Empty value = open API, allowed ONLY when APP_ENV=development (local dev).
API_KEY=CHANGEME

# --- Celery ---
CELERY_BROKER_URL=redis://:CHANGEME@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGEME@localhost:6379/1
